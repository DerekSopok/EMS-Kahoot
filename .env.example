# Database Configuration
DATABASE_URL=postgresql://user:password@host:5432/database

# Application Configuration
NODE_ENV=development
PORT=3000
ADMIN_TOKEN=your-secure-random-token-here

# GitHub Auto-Commit Configuration
# Required for quiz management to persist data on Render
GITHUB_TOKEN=your_github_token_here
GITHUB_OWNER=DerekSopok
GITHUB_REPO=EMS-Kahoot
GITHUB_BRANCH=Production

# For production deployment on Render.com:
# 1. DATABASE_URL will be automatically provided by Render PostgreSQL addon
# 2. Set NODE_ENV=production in Render environment variables
# 3. PORT will be automatically set by Render
# 4. Add GITHUB_TOKEN from GitHub Settings > Developer settings > Personal access tokens
